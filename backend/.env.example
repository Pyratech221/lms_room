SECRET_KEY=replace-me
DEBUG=True

# Hôtes et origines autorisés (séparés par des virgules).
# Tunnel VSCode : ajouter le domaine du port 8000, ex. ldh773nh-8000.uks1.devtunnels.ms
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookies cross-domaine (frontend et backend sur des domaines différents).
# En HTTPS uniquement : COOKIE_SAMESITE=None et COOKIE_SECURE=True
COOKIE_SAMESITE=Lax
COOKIE_SECURE=False

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Envoi des liens de connexion via Microsoft Graph (Microsoft 365 / OAuth 2.0).
# Voir le README pour la procédure d'inscription de l'application dans Microsoft Entra ID.
