# Variables lues par docker-compose (à ne pas confondre avec backend/.env,
# qui porte les secrets applicatifs : SECRET_KEY, Microsoft Graph…).
# Copier ce fichier en .env : cp .env.example .env

# Identifiants PostgreSQL — utilisés à la fois par le conteneur db et par le backend.
DB_NAME=reservation_salles
DB_USER=postgres
DB_PASSWORD=change-me

# Port exposé sur la machine hôte, et URL publique correspondante.
APP_PORT=8080
APP_URL=http://localhost:8080
